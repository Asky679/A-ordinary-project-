# Copy to .env before deployment. Never commit the real .env file.
POSTGRES_DB=careernav
POSTGRES_USER=careernav
POSTGRES_PASSWORD=change-this-database-password
APP_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_PORT=8080

# Optional OpenAI-compatible model. Leave empty to use local Agent fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Container images can be pinned here for controlled upgrades.
POSTGRES_IMAGE=postgres:18-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.19.2
